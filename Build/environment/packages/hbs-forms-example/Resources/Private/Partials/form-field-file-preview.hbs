<p>
    <strong>{{get resource 'originalResource.originalFile.name'}}</strong>
    <br>

    {{#if deleteCheckbox}}
        {{> '@form-field-checkbox'
            disableContainer=true
            id=(join ../id "-remove-" index)
            label="Delete file"
            name=(get deleteCheckbox 'element.name')
            value=(get deleteCheckbox 'element.value')
        }}
    {{/if}}
</p>
